# URL base del API. Se inyecta en tiempo de build (Vite inlinea las VITE_*),
# asi que NO va en el codigo fuente.
#
#   - Dev con el proxy de vite.config.ts y prod con reverse proxy: /api
#   - Back separado en otro origen: https://api.tudominio.com/api
#
# Si no se define, se usa /api.
VITE_API_URL=http://localhost:3000/api

# Para desplegar, pasala por la shell/CI para que no se cuele tu .env.local:
#   VITE_API_URL=https://api.tudominio.com/api pnpm --filter @class-hub/frontend build
